<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ─── PERMISSIONS ─────────────────────────────────────────────────── -->

    <!-- Core network access (calls to Vercel API) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice journaling + Jarvis voice calls -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- REQUIRED for getUserMedia in the WebView: Capacitor's BridgeWebChromeClient requests
         RECORD_AUDIO *and* MODIFY_AUDIO_SETTINGS together and denies the mic unless BOTH are
         granted. Undeclared = always denied → "Microphone permission is needed". Don't remove.
         (Normal permission: auto-granted at install, no user prompt.) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Jarvis calls ring on time with the app closed: pre-scheduled alarms use exact timing
         when the user grants it (Settings → "Exact timing"); otherwise Android fires them late
         while idle. Android 14 denies this by default, so the in-app button opens the toggle. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Push / local streak notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Home screen widget -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <!-- ─── MAIN ACTIVITY ───────────────────────────────────────────── -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ─── FILE PROVIDER ───────────────────────────────────────────── -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ─── SUN WARRIOR HOME SCREEN WIDGET ─────────────────────────── -->
        <receiver
            android:name=".SunWarriorWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Triggered from JS bridge after gamification update -->
                <action android:name="com.dayly.WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sun_warrior_widget_info" />
        </receiver>

        <!-- ─── TASKS WIDGET ─────────────────────────────────────────────── -->
        <receiver
            android:name=".TasksWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dayly.WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <!-- ─── HABITS WIDGET ────────────────────────────────────────────── -->
        <receiver
            android:name=".HabitsWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dayly.WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habits_widget_info" />
        </receiver>

        <!-- ─── GOALS WIDGET ─────────────────────────────────────────────── -->
        <receiver
            android:name=".GoalsWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dayly.WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/goals_widget_info" />
        </receiver>

        <service
            android:name=".TasksWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Reschedule notifications after device reboot -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
